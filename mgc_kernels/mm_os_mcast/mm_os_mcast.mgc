# Francesco Conti <f.conti@unibo.it>
#
# Output-static GEMM on the MAGIA mesh, as mm_os, with the operands multicast:
#
#     Z = X @ W + Y
#
# The tiles of a mesh row need the same X slice in each timeslot and the tiles of a mesh column the same W slice, so
# one tile of the row loads the X slice from L2 and multicasts it to the other tiles of its row, and one tile of the
# column does the same with the W slice down its column. L2 is read once per slice instead of once per tile.

from mgc import *

M, N, K = sizes("M_SIZE", "N_SIZE", "K_SIZE")  # kernel arguments
X = l2("x_inp", (M, N), fp16)
W = l2("w_inp", (N, K), fp16)
Y = l2("y_inp", (M, K), fp16)  # bias in, result out
Z = l2("z_out", (M, K), fp16)  # golden

N_ITERATIONS = define(1)
T_SIZE = define(64)  # reduction (N) rows per timeslot, N_SIZE / T_SIZE timeslots
# Outer blocking: the output is processed in M_NB blocks of M_BLK rows in turn (M_NB must divide M_SIZE), so that
# the L1-resident output block of a tile is M_BLK / MESH_Y_TILES rows (M_NB = 1: the whole output at once)
M_NB = define(1)
M_BLK = define("(M_SIZE / M_NB)")
WAIT_MODE = define(WFE)


@kernel("mgc_mm_os_mcast", check=(Y, Z), tol=0x11)
def mm_os_mcast():
    """
    Output-static GEMM as mm_os, the X and W slices of each timeslot loaded from L2 by one tile of the row /
    column and multicast to the others.
    """
    for y_id, x_id in tiles():
        """
        0. Outer blocking: output rows [mb * M_BLK, (mb + 1) * M_BLK) in turn.
        """
        for mb in range(M_NB):
            """
            1. The static output data-tile of this tile (as mm_os).
            """
            tile_h = y_id.split(M_BLK)
            tile_w = x_id.split(K)
            # first output row of this tile in the block
            m0: u32 = mb * M_BLK + tile_h.start

            t_size: u16 = T_SIZE
            timeslots: u16 = N // t_size

            """
            2. Static output data-tile, resident in L1 for the whole block.
            """
            y = L1.single_buffer(Y[tile_h, tile_w])

            """
            2a. Input and weight data-tile multi-buffers, depth 3. The multicasts of timeslot i + 1 write slot
            (i + 1) % 3 on the other tiles, i.e. the slot of timeslot i - 2: they start after the W barrier of
            timeslot i, which every tile enters after waiting its job i - 2.
            """
            x = L1.multi_buffer(X[tile_h, 0:t_size], depth=3)
            w = L1.multi_buffer(W[0:t_size, tile_w], depth=3)
            redmule_evt = redmule.events(2)

            for z in range(N_ITERATIONS):
                """
                3. Prologue: the output tile, the operands of timeslot 0 (loaded by tile (y_id, 0) / (0, x_id) and
                multicast, X then W, a barrier after each), the L2 loads of timeslot 1. The W barrier of timeslot 0 is
                only entered here: the loop waits it.
                """
                ey = idma.load(y, Y[m0:m0 + tile_h.size, tile_w])
                if x_id == 0:
                    ex = idma.load(x[0], X[m0:m0 + tile_h.size, 0:t_size])
                if y_id == 0:
                    ew = idma.load(w[0], W[0:t_size, tile_w])
                if x_id == 0:
                    ex.wait()
                    emx = idma.store(x.row[0], x[0])
                    emx.wait()
                sync(GLOBAL)
                if y_id == 0:
                    ew.wait()
                    emw = idma.store(w.col[0], w[0])
                if timeslots > 1:
                    if x_id == 1 % MESH_X_TILES:
                        ex = idma.load(x[1], X[m0:m0 + tile_h.size, t_size:2 * t_size])
                if y_id == 0:
                    emw.wait()
                if timeslots > 1:
                    if y_id == 1 % MESH_Y_TILES:
                        ew = idma.load(w[1], W[t_size:2 * t_size, tile_w])
                sync_start(GLOBAL)
                ey.wait()

                """
                4. Timeslot i: wait the W barrier of i (its operands have landed), start job i, then move the
                operands of i + 1 while it runs, with split barriers (sync_start / sync_wait) so that only the tile
                that pushes waits for its multicast:
                  - X: the tile of column (i + 1) % MESH_X_TILES of each row multicasts the X slice to its row; the
                    others enter the barrier at once, the pusher after its multicast has completed;
                  - W, only once the X barrier is released (a row and a column hardware multicast that cross can
                    deadlock in the NoC): the same down the columns, its barrier waited at the next timeslot.
                The L2 loads of timeslot i + 2 go into the slot of job i - 1: the W one right after waiting that job (it is
                the long one: its multicast waits for it), the X one after the X multicast.
                """
                for i in range(timeslots):
                    sync_wait()
                    redmule.enqueue(x[i], w[i], y, op=GEMM, event=redmule_evt[i])
                    redmule.commit_start()
                    if i < timeslots - 1:
                        if x_id == (i + 1) % MESH_X_TILES:
                            ex.wait()
                            emx = idma.store(x.row[i + 1], x[i + 1])
                        else:
                            sync_start(GLOBAL)
                    if i > 0:
                        redmule_evt[i - 1].wait()
                    if i < timeslots - 2:
                        if y_id == (i + 2) % MESH_Y_TILES:
                            ew = idma.load(w[i + 2], W[(i + 2) * t_size:(i + 3) * t_size, tile_w])
                    if i < timeslots - 1:
                        if x_id == (i + 1) % MESH_X_TILES:
                            emx.wait()
                            sync_start(GLOBAL)
                        if i < timeslots - 2:
                            if x_id == (i + 2) % MESH_X_TILES:
                                ex = idma.load(x[i + 2], X[m0:m0 + tile_h.size, (i + 2) * t_size:(i + 3) * t_size])
                        sync_wait()
                        if y_id == (i + 1) % MESH_Y_TILES:
                            ew.wait()
                            emw = idma.store(w.col[i + 1], w[i + 1])
                            emw.wait()
                        sync_start(GLOBAL)
                    else:
                        redmule_evt[i].wait()

                """
                5. Store the output data-tile back to L2
                """
                idma.store(Y[m0:m0 + tile_h.size, tile_w], y).wait()
